  HostTablesReady := True;
end;

function GetHostDestName(const Host, Ver, Arch: String): String;
var
  I: Integer;
begin
  InitHostTables;
  Result := '';
  for I := 0 to HostLoaderCount - 1 do
  begin
    if (HostLoaders[I].Host = Host) and (HostLoaders[I].Ver = Ver) and (HostLoaders[I].Arch = Arch) then
    begin
      Result := HostLoaders[I].DestName;
      Exit;
    end;
  end;
end;

function IsAvailable(const Host: String; const Ver: String; const Arch: String): Boolean;
var
  I: Integer;
  ProductKey: String;
  DetectKey: String;
begin
  InitHostTables;
  Result := False;
  for I := 0 to HostProbeCount - 1 do
  begin
    if (HostProbes[I].Host <> Host) or (HostProbes[I].Ver <> Ver) or (HostProbes[I].Arch <> Arch) then
      Continue;
    if (HostProbes[I].Arch = 'x64') and (not IsWin64()) then
      Continue;
    if HostProbes[I].AdminDetectOnly and (not IsAdminInstallMode()) then
      Continue;
    if not RegQueryStringValue(HostProbes[I].CurVerHive, HostProbes[I].Key, HostProbes[I].CurVerName, ProductKey) then
      Continue;
    DetectKey := HostProbes[I].Key + '\' + ProductKey;
    if HostProbes[I].DetectRequiresApps then
      DetectKey := DetectKey + '\Applications';
    if RegKeyExists(HostProbes[I].AppsHive, DetectKey) then
    begin
      FoundSupportedHost := True;
      Result := True;
      Exit;
    end;
  end;
end;

procedure SetupDemandload(const Host: String; const Ver: String; const Arch: String);
var
  I: Integer;
  ProductKey: String;
  AppsKey: String;
  Loader: String;
  Root: Integer;
begin
  Loader := GetHostDestName(Host, Ver, Arch);
  if Loader = '' then
    Exit;
  for I := 0 to HostProbeCount - 1 do
  begin
    if (HostProbes[I].Host <> Host) or (HostProbes[I].Ver <> Ver) or (HostProbes[I].Arch <> Arch) then
      Continue;
    if (HostProbes[I].Arch = 'x64') and (not IsWin64()) then
      Continue;
    if HostProbes[I].AdminDetectOnly and (not IsAdminInstallMode()) then
      Continue;
    if not RegQueryStringValue(HostProbes[I].CurVerHive, HostProbes[I].Key, HostProbes[I].CurVerName, ProductKey) then
      Continue;
    AppsKey := HostProbes[I].Key + '\' + ProductKey + '\Applications';
    case HostProbes[I].WriteRootKind of
      wrPreferred32: Root := GetPreferredRoot32();
      wrPreferred64: Root := GetPreferredRoot64();
      wrHklm32:
        begin
          if not IsAdminInstallMode() then
            Continue;
          Root := HKLM32;
        end;
    else
      Continue;
    end;
    if HostProbes[I].LoaderStyle = lsAcadR15 then
      PopulateDemandloadKeyAcadR15(Root, AppsKey, Loader)
    else
      PopulateDemandloadKey(Root, AppsKey, Loader);
  end;
end;

procedure DeleteAllDemandloadKeys();
var
  I: Integer;
begin
  InitHostTables;
  for I := 0 to HostProbeCount - 1 do
  begin
    if (HostProbes[I].Arch = 'x64') and (not IsWin64()) then
      Continue;
    case HostProbes[I].WriteRootKind of
      wrPreferred32:
        begin
          if IsAdminInstallMode() then
            DeleteDemandloadKeys(HKLM32, HostProbes[I].Key);
          DeleteDemandloadKeys(HKCU32, HostProbes[I].Key);
        end;
      wrPreferred64:
        begin
          if not IsWin64() then
            Continue;
          if IsAdminInstallMode() then
            DeleteDemandloadKeys(HKLM64, HostProbes[I].Key);
          DeleteDemandloadKeys(HKCU64, HostProbes[I].Key);
        end;
      wrHklm32:
        begin
          if IsAdminInstallMode() then
            DeleteDemandloadKeys(HKLM32, HostProbes[I].Key);
          DeleteDemandloadKeys(HKCU32, HostProbes[I].Key);
        end;
    end;
  end;
end;
